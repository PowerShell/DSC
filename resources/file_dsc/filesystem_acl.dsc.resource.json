{
    "$schema": "https://aka.ms/dsc/schemas/v3/bundled/resource/manifest.json",
    "type": "Microsoft.Filesystem/ACL",
    "description": "Manage the discretionary access control list of a local file or folder.",
    "tags": [
        "file",
        "folder",
        "windows"
    ],
    "version": "0.1.0",
    "get": {
        "executable": "file_dsc",
        "args": [
            "acl",
            "get",
            {
                "jsonInputArg": "--input",
                "mandatory": true
            }
        ]
    },
    "set": {
        "executable": "file_dsc",
        "args": [
            "acl",
            "set",
            {
                "jsonInputArg": "--input",
                "mandatory": true
            }
        ],
        "implementsPretest": false,
        "return": "state"
    },
    "test": {
        "executable": "file_dsc",
        "args": [
            "acl",
            "test",
            {
                "jsonInputArg": "--input",
                "mandatory": true
            }
        ],
        "return": "state"
    },
    "exitCodes": {
        "0": "Success",
        "1": "Invalid arguments",
        "2": "Invalid input",
        "3": "Filesystem ACL operation error"
    },
    "schema": {
        "embedded": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "title": "Filesystem ACL",
            "description": "Manage the discretionary access control list of a local file or folder.",
            "type": "object",
            "required": [
                "path",
                "SDDL"
            ],
            "properties": {
                "path": {
                    "type": "string",
                    "title": "Path",
                    "description": "The path to the local file or folder.",
                    "minLength": 1,
                    "x-dsc-key": true
                },
                "SDDL": {
                    "type": "string",
                    "title": "Security descriptor definition language",
                    "description": "The complete discretionary access control list in SDDL form. Setting this property replaces the existing DACL, including its protection state.",
                    "minLength": 1
                },
                "_inDesiredState": {
                    "$ref": "https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/v3/resource/properties/inDesiredState.json"
                }
            },
            "additionalProperties": false,
            "$defs": {
                "https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/v3/resource/properties/inDesiredState.json": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "$id": "https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/v3/resource/properties/inDesiredState.json",
                    "title": "Instance is in the Desired State",
                    "description": "Indicates whether the instance is in the desired state. This property is only returned by the `test` method.",
                    "type": [
                        "boolean",
                        "null"
                    ],
                    "readOnly": true
                }
            }
        }
    }
}
