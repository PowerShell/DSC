{
    "resources": [
        {
            "$schema": "https://aka.ms/dsc/schemas/v3/bundled/resource/manifest.json",
            "description": "Returns information about running processes on Windows, Linux, and macOS.",
            "type": "Microsoft.System/Process",
            "author": "Microsoft",
            "tags": ["Windows", "Linux", "macOS", "Process"],
            "version": "0.1.0",
            "get": {
                "executable": "process",
                "args": ["get", { "jsonInputArg": "--input", "mandatory": true }]
            },
            "export": {
                "executable": "process",
                "args": ["export", { "jsonInputArg": "--input", "mandatory": false }],
                "supportsFiltering": true
            },
            "exitCodes": {
                "0": "Success",
                "1": "Invalid arguments",
                "2": "Invalid input",
                "3": "Process query failed"
            },
            "schema": {
                "embedded": {
                    "$schema": "http://json-schema.org/draft-07/schema#",
                    "title": "Process",
                    "type": "object",
                    "properties": {
                        "pid": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
                        "name": { "type": "string" },
                        "cmdline": { "type": "array", "items": { "type": "string" }, "readOnly": true }
                    },
                    "additionalProperties": false
                }
            }
        }
    ],
    "actions": [
        {
            "$schema": "https://aka.ms/dsc/schemas/v3/bundled/action/manifest.json",
            "type": "Microsoft.System.Action/TerminateProcess",
            "version": "0.1.0",
            "description": "Terminates a process by PID or all processes with an exact name.",
            "author": "Microsoft",
            "tags": ["Windows", "Linux", "macOS", "Process"],
            "supportedOperations": ["set"],
            "invoke": {
                "executable": "process",
                "args": ["terminate", { "jsonInputArg": "--input", "mandatory": true }],
                "inputSchema": {
                    "embedded": {
                        "type": "object",
                        "additionalProperties": false,
                        "oneOf": [
                            { "required": ["pid"] },
                            { "required": ["name"] }
                        ],
                        "properties": {
                            "pid": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
                            "name": { "type": "string", "minLength": 1, "pattern": "^[^*]+$" }
                        }
                    }
                },
                "outputSchema": {
                    "embedded": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["terminated"],
                        "properties": {
                            "terminated": {
                                "type": "array",
                                "minItems": 1,
                                "items": {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "required": ["pid", "name", "cmdline"],
                                    "properties": {
                                        "pid": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
                                        "name": { "type": "string" },
                                        "cmdline": { "type": "array", "items": { "type": "string" } }
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "exitCodes": {
                "0": "Success",
                "1": "Invalid arguments",
                "2": "Invalid input",
                "3": "Process enumeration or termination failed"
            }
        }
    ]
}
