{
    "$schema": "https://aka.ms/dsc/schemas/v3/bundled/action/manifest.json",
    "type": "Test/Action2",
    "version": "0.1.0",
    "description": "An action for testing.",
    "author": "DSC Team",
    "tags": [
        "test",
        "action"
    ],
    "condition": "[true()]",
    "invoke": {
        "executable": "dsctest",
        "args": [
            "action",
            {
                "jsonInputArg": "--input",
                "mandatory": true
            }
        ]
    }
}